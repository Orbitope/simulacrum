{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "toywalk state and trajectory schemas",
  "$defs": {
    "state": {
      "type": "object",
      "description": "One toywalk state: integer position on the line and the in-episode step counter. All-integer state; no x-atol declared.",
      "properties": {
        "position": { "type": "integer", "minimum": -5, "maximum": 5 },
        "t": { "type": "integer", "minimum": 0, "maximum": 60 }
      },
      "required": ["position", "t"],
      "additionalProperties": false
    },
    "action": {
      "description": "0 = left, 1 = right.",
      "type": "integer",
      "enum": [0, 1]
    },
    "trajectory": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "env": { "type": "string" },
            "format_version": { "type": "string" },
            "simulacrum_version": { "type": "string" },
            "seed": { "type": "integer" },
            "source": { "enum": ["reference", "batched"] },
            "instance": { "type": ["integer", "null"] },
            "git_sha": { "type": ["string", "null"] },
            "created_at": { "type": "string" }
          },
          "required": ["env", "format_version", "seed", "source", "created_at"]
        },
        "initial": {
          "type": "object",
          "properties": {
            "episode": { "type": "integer" },
            "state": { "$ref": "#/$defs/state" }
          },
          "required": ["episode", "state"]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": { "type": "integer" },
              "episode": { "type": "integer" },
              "state": { "$ref": "#/$defs/state" },
              "action": { "$ref": "#/$defs/action" },
              "reward": { "type": "number" },
              "terminated": { "type": "boolean" }
            },
            "required": ["t", "episode", "state", "action", "reward", "terminated"]
          }
        }
      },
      "required": ["metadata", "initial", "steps"]
    }
  }
}
